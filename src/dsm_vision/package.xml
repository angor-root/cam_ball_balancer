<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>dsm_vision</name>
  <version>0.1.0</version>
  <description>
    MT5001 DSM project — ball-on-plate vision: ball position (color
    detection + Kalman filter) and plate pose (ArUco corner tags, no
    encoder exists for this angle). Core algorithms are plain
    OpenCV/numpy (testable without ROS); this package adds the ROS2
    node wrappers.
  </description>
  <maintainer email="caleb.churata@utec.edu.pe">Caleb Churata</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>cv_bridge</depend>
  <depend>dsm_vision_msgs</depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-numpy</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
